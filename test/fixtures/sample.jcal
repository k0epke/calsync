            ["dtstart", {}, "date-time", "1970-03-08T02:00:00"],
            ["rrule", {}, "recur", {"freq": "yearly", "bymonth": "3", "byday": ["2su"]}]
          ],
          []
        ],
        ["standard",
          [
            ["tzoffsetfrom", {}, "utc-offset", "-05:00"],
            ["tzoffsetto", {}, "utc-offset", "-06:00"],
            ["tzname", {}, "text", "CST"],
            ["dtstart", {}, "date-time", "1970-11-01T02:00:00"],
            ["rrule", {}, "recur", {"freq": "yearly", "bymonth": "11", "byday": ["1su"]}]
          ],
          []
        ]
      ]
    ],
    ["vevent",
      [
        ["uid", {}, "text", "jcal-1@example.com"],
        ["dtstamp", {}, "date-time", "2026-01-01T12:00:00Z"],
        ["dtstart", {"tzid": "America/Chicago"}, "date-time", "2026-03-01T09:00:00"],
        ["dtend", {"tzid": "America/Chicago"}, "date-time", "2026-03-01T10:00:00"],
        ["summary", {}, "text", "From JCal"],
        ["rrule", {}, "recur", {"freq": "daily", "count": "3"}]
      ],
      []
    ],
    ["vevent",
      [
        ["uid", {}, "text", "jcal-2@example.com"],
