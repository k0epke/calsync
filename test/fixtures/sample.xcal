<?xml version="1.0" encoding="UTF-8"?>
<icalendar xmlns="urn:ietf:params:xml:ns:ietf-icalendar-2.0">
  <vcalendar>
    <prodid><text>-//Example//XCal Test//EN</text></prodid>
    <version><text>2.0</text></version>
    <x-wr-calname><text>XCal Feed</text></x-wr-calname>
    <vtimezone>
      <tzid><text>America/Chicago</text></tzid>
      <daylight>
        <tzoffsetfrom><utc-offset>-06:00</utc-offset></tzoffsetfrom>
        <tzoffsetto><utc-offset>-05:00</utc-offset></tzoffsetto>
        <tzname><text>CDT</text></tzname>
        <dtstart><date-time>1970-03-08T02:00:00</date-time></dtstart>
        <rrule><recur><freq>YEARLY</freq><bymonth>3</bymonth><byday>2SU</byday></recur></rrule>
      </daylight>
      <standard>
        <tzoffsetfrom><utc-offset>-05:00</utc-offset></tzoffsetfrom>
        <tzoffsetto><utc-offset>-06:00</utc-offset></tzoffsetto>
        <tzname><text>CST</text></tzname>
        <dtstart><date-time>1970-11-01T02:00:00</date-time></dtstart>
        <rrule><recur><freq>YEARLY</freq><bymonth>11</bymonth><byday>1SU</byday></recur></rrule>
      </standard>
    </vtimezone>
    <vevent>
      <uid><text>xcal-1@example.com</text></uid>
      <dtstamp><date-time>2026-01-01T12:00:00Z</date-time></dtstamp>
      <dtstart><parameters><tzid><text>America/Chicago</text></tzid></parameters><date-time>2026-03-01T09:00:00</date-time></dtstart>
      <dtend><parameters><tzid><text>America/Chicago</text></tzid></parameters><date-time>2026-03-01T10:00:00</date-time></dtend>
      <summary><text>From XCal</text></summary>
      <description><text>Hello &lt;World&gt; &amp; friends</text></description>
      <rrule><recur><freq>DAILY</freq><count>5</count></recur></rrule>
    </vevent>
    <vevent>
      <uid><text>xcal-2@example.com</text></uid>
      <dtstamp><date-time>2026-01-01T12:00:00Z</date-time></dtstamp>
      <dtstart><date>2026-04-01</date></dtstart>
      <dtend><date>2026-04-02</date></dtend>
      <summary><text>XCal all-day</text></summary>
    </vevent>
  </vcalendar>
</icalendar>
