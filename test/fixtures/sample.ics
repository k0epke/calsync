BEGIN:VCALENDAR
PRODID:-//Example//CalSync Test//EN
VERSION:2.0
CALSCALE:GREGORIAN
X-WR-CALNAME:Test Feed Calendar
BEGIN:VTIMEZONE
TZID:America/Chicago
BEGIN:DAYLIGHT
TZOFFSETFROM:-0600
TZOFFSETTO:-0500
TZNAME:CDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0500
TZOFFSETTO:-0600
TZNAME:CST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:event-simple@example.com
DTSTAMP:20260101T120000Z
DTSTART;TZID=America/Chicago:20260301T090000
DTEND;TZID=America/Chicago:20260301T100000
SUMMARY:Simple event
LOCATION:Room 101
DESCRIPTION:This is a deliberately long description that is folded across mu
 ltiple physical lines to exercise RFC 5545 unfolding rules.
STATUS:CONFIRMED
BEGIN:VALARM
TRIGGER:-PT15M
ACTION:DISPLAY
DESCRIPTION:Reminder
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:event-recur@example.com
DTSTAMP:20260101T120000Z
DTSTART;TZID=America/Chicago:20260302T090000
DTEND;TZID=America/Chicago:20260302T093000
SUMMARY:Daily standup
RRULE:FREQ=DAILY;COUNT=20
EXDATE;TZID=America/Chicago:20260305T090000
END:VEVENT
BEGIN:VEVENT
UID:event-allday@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260401
DTEND;VALUE=DATE:20260402
SUMMARY:All day event
END:VEVENT
BEGIN:VEVENT
UID:event-cancelled@example.com
DTSTAMP:20260101T120000Z
DTSTART;TZID=America/Chicago:20260310T140000
DTEND;TZID=America/Chicago:20260310T150000
SUMMARY:Cancelled meeting
STATUS:CANCELLED
END:VEVENT
BEGIN:VEVENT
UID:event-recur-until@example.com
DTSTAMP:20260101T120000Z
DTSTART;TZID=America/Chicago:20250106T090000
DTEND;TZID=America/Chicago:20250106T093000
SUMMARY:Weekly until
RRULE:FREQ=WEEKLY;UNTIL=20250228T235959Z
END:VEVENT
BEGIN:VEVENT
UID:event-duration@example.com
DTSTAMP:20260101T120000Z
DTSTART;TZID=America/Chicago:20260315T130000
DURATION:PT1H30M
SUMMARY:Duration event
END:VEVENT
BEGIN:VEVENT
UID:event-utc@example.com
DTSTAMP:20260101T120000Z
DTSTART:20260601T120000Z
DTEND:20260601T130000Z
SUMMARY:UTC event
STATUS:TENTATIVE
END:VEVENT
END:VCALENDAR
