# --- Server ---
# Bind address. Keep 127.0.0.1 unless behind a reverse proxy; set HOST=0.0.0.0
# explicitly to bind publicly (see deploy/nginx-calsync.conf).
HOST=127.0.0.1
PORT=8787
# SQLite database path (default: <project>/data/calsync.db)
#CALSYNC_DB_PATH=data/calsync.db
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Dashboard login ---
ADMIN_USERNAME=admin
# CHANGE THIS. Creates/refreshes the admin account (bcrypt-hashed in SQLite).
ADMIN_PASSWORD=change-me-long-random
# Session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# On loopback binds only, an ephemeral secret is generated if this is empty.
SESSION_SECRET=
# Set true when serving over HTTPS behind a reverse proxy.
SESSION_COOKIE_SECURE=false
# Set true behind nginx so rate limiting sees the real client IP (X-Forwarded-For).
TRUST_PROXY=false

# --- Google OAuth client (from Google Cloud console; see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one "Authorized redirect URI" on the OAuth client, e.g.
#   https://cal.example.com/oauth/callback
# Leave empty to default to http://HOST:PORT/oauth/callback (fine for local dev).
GOOGLE_REDIRECT_URL=

# --- Sync tuning (optional) ---
# IANA timezone used for cron schedules (default: system timezone).
#CALSYNC_TZ=America/Chicago
# Small delay between sequential Google pushes (ms). Default 250.
#PUSH_DELAY_MS=250
# Max feed size in bytes. Default 10485760 (10 MiB).
#MAX_FEED_BYTES=10485760
# Feed fetch timeout (ms). Default 30000.
#FETCH_TIMEOUT_MS=30000
# Event window: import events starting/occurring within [now-past, now+future].
#WINDOW_PAST_DAYS=30
#WINDOW_FUTURE_DAYS=365
# Dashboard login rate limiting.
#LOGIN_MAX_ATTEMPTS=8
#LOGIN_WINDOW_MINUTES=15

# --- iCloud (CalDAV) calendar source (optional; one-way read into Google) ---
# Apple ID (an email address) + an APP-SPECIFIC password generated at
# https://appleid.apple.com (Sign-In and Security -> App-Specific Passwords;
# requires two-factor authentication). NEVER use the real account password.
# One iCloud account per deployment; leave both empty to disable CalDAV
# sources. The password is a secret: it stays in .env, is never logged and
# never appears in URLs or errors.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
